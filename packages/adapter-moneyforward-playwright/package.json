{
  "name": "@mf-suite/adapter-moneyforward-playwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --config ../../vitest.config.ts --project @mf-suite/adapter-moneyforward-playwright",
    "spike:login": "pnpm build && node dist/spike/login.js",
    "spike:refresh": "pnpm build && node dist/spike/refresh.js"
  },
  "dependencies": {
    "@mf-suite/core": "workspace:*",
    "@mf-suite/security": "workspace:*",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
