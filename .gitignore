# macOS
.DS_Store

# Claude Code の個人用ローカル設定（開発者ごとのマシン固有設定）
.claude/settings.local.json

# Playwright MCP の出力（スクリーンショット等。金融情報を含み得るためコミットしない）
.playwright-mcp/

# Playwright MCP は filename を明示した保存をリポジトリ直下（workspace root）へ行うため、直下の成果物も除外する
/*.png
/*.jpg
/*.jpeg
/*.webm
/*.har
/*.zip

# Node.js / pnpm
node_modules/

# TypeScript のビルド生成物
dist/
*.tsbuildinfo

# テスト・カバレッジ
coverage/

# 環境変数（.env.example のみ追跡する）
.env*
!.env.example

# ローカル専用ファイル（認証セッション等。AI セッションは読まない）
.local/

# Playwright の Artifact（金融情報を含み得るためコミットしない）
test-results/
playwright-report/
blob-report/
