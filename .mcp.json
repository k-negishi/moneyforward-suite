{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--image-responses",
        "omit",
        "--output-dir",
        ".playwright-mcp",
        "--output-max-size",
        "67108864"
      ],
      "env": {}
    },
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    }
  }
}