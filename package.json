{
  "name": "moneyforward-suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm -r --if-present run typecheck && tsc -p tests/tsconfig.check.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:architecture": "vitest run --project repo-policy --passWithNoTests=false architecture",
    "refresh-accounts": "pnpm -C apps/automation refresh-accounts",
    "clean": "tsc -b --clean && rm -rf apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
